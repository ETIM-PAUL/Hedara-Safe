{
  "name": "safe-treasury-rebalance-static",
  "description": "Static invariants for the finished hedera-safe-swap template.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "engines.node",
      "equals": ">=20.18.3"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "LICENSE",
      "template.json",
      "package.json",
      "packages/contracts/package.json",
      "packages/contracts/scripts/deploy.ts",
      "packages/contracts/scripts/demo-rebalance.ts",
      "packages/contracts/contracts/RebalanceModule.sol",
      "packages/contracts/contracts/PriceGuardedRebalanceModule.sol",
      "packages/contracts/contracts/oracle/IPriceOracleAdapter.sol",
      "packages/contracts/contracts/oracle/ChainlinkPriceAdapter.sol",
      "packages/contracts/contracts/oracle/SupraPriceAdapter.sol",
      "packages/contracts/scripts/deploy-oracle-adapters.ts",
      "packages/contracts/scripts/deploy-multisig-rebalance.ts",
      "packages/contracts/scripts/create-proposals-topic.ts",
      "packages/contracts/scripts/deploy-majority-guard.ts",
      "packages/contracts/contracts/MajorityThresholdGuard.sol",
      "packages/frontend/lib/safe.ts",
      "packages/frontend/lib/rebalance.ts",
      "packages/frontend/lib/multisig.ts",
      "packages/frontend/lib/useMultisigRebalance.ts",
      "packages/frontend/lib/hcs.ts",
      "packages/frontend/app/api/proposals/route.ts",
      "packages/frontend/lib/priceGuard.ts",
      "packages/frontend/lib/usePriceGuard.ts",
      "packages/frontend/lib/txStatus.ts",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [
      ".env",
      "packages/contracts/.env",
      "packages/frontend/.env"
    ]
  },
  "textAssertions": [
    {
      "file": "README.md",
      "contains": [
        "npm install",
        "hashscan.io/testnet/transaction"
      ]
    }
  ]
}
