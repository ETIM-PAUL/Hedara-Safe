# Hedera testnet operator account (get funded testnet HBAR from the Hedera Portal faucet)
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=

# JSON-RPC relay endpoint for Hedera testnet
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# SaucerSwap router contract address on Hedera testnet (contract side — Hardhat scripts)
SAUCERSWAP_ROUTER_ADDRESS=

# Same address, exposed to the browser for live swap quotes (frontend can't read the
# non-prefixed var above — see AGENTS.md on NEXT_PUBLIC_* static-reference requirements)
NEXT_PUBLIC_SAUCERSWAP_ROUTER_ADDRESS=

# Filled in after Phase 4 (Safe deployment) — printed by deploy.ts
NEXT_PUBLIC_SAFE_ADDRESS=
NEXT_PUBLIC_MODULE_ADDRESS=

# Optional — printed by deploy-price-guard.ts. The frontend's "Price Guard" section hides itself
# if this is unset.
NEXT_PUBLIC_PRICE_GUARD_MODULE_ADDRESS=

# Optional — which treasury tokens the frontend dashboard shows. Defaults to the WHBAR/SAUCE
# testnet pair demo-rebalance.ts uses if left unset.
NEXT_PUBLIC_TOKEN_IN_ADDRESS=
NEXT_PUBLIC_TOKEN_IN_SYMBOL=
NEXT_PUBLIC_TOKEN_OUT_ADDRESS=
NEXT_PUBLIC_TOKEN_OUT_SYMBOL=

# Pyth Hermes API key (server-side only — never prefix with NEXT_PUBLIC_, never commit). Not
# currently used by the frontend; the Price Guard trigger reads whatever price Pyth's testnet
# contract already has on-chain rather than pushing a fresh one. See README's "Known limitation."
PYTH_HERMES_API_KEY=
