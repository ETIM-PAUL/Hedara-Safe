# Hedera testnet operator account (get funded testnet HBAR from the Hedera Portal faucet).
# The only two values you must fill in — `npm run deploy:testnet` writes the rest below.
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=

# JSON-RPC relay endpoint for Hedera testnet
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api

# Same endpoint, exposed to the browser — lets the frontend read public Safe state (owners,
# threshold, balances) before a wallet connects, not just after. Public testnet RPC, no secret.
NEXT_PUBLIC_HEDERA_RPC_URL=https://testnet.hashio.io/api

# SaucerSwap V1 router on Hedera testnet (contract 0.0.19264) — for Hardhat scripts, and the same
# address exposed to the browser for live swap quotes (the frontend can't read the non-prefixed
# var — see AGENTS.md on NEXT_PUBLIC_* static-reference requirements)
SAUCERSWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000004b40
NEXT_PUBLIC_SAUCERSWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000004b40

# Shared, stateless contracts already live on testnet — any Safe can use them, so deploy.ts reuses
# these instead of redeploying. The Chainlink (HBAR/USD) and Supra (pair 432, HBAR/USD) adapters
# are what the Price Guard can switch between; MAJORITY_GUARD_ADDRESS is the Safe transaction
# guard that keeps a strict majority of owners in charge. Clear one to have deploy.ts deploy your own.
NEXT_PUBLIC_CHAINLINK_ADAPTER_ADDRESS=0xB6867f3Fc37bbEB92C8ff717A3DBEAaeb914D25f
NEXT_PUBLIC_SUPRA_ADAPTER_ADDRESS=0x6E4933E4f2582865A4BDa4250a1A0E5e0b790Eb1
MAJORITY_GUARD_ADDRESS=0xeC1685873e305239040d22B9702D907d72A00f8A

# Written by `npm run deploy:testnet` — one of each per Safe. The Safe, its RebalanceModule, its
# PriceGuardedRebalanceModule, and its own HCS topic for proposals (one per Safe: proposals don't
# name their Safe, so a shared topic would mix every Safe's proposals together).
NEXT_PUBLIC_SAFE_ADDRESS=
NEXT_PUBLIC_MODULE_ADDRESS=
NEXT_PUBLIC_PRICE_GUARD_MODULE_ADDRESS=
NEXT_PUBLIC_PROPOSALS_TOPIC_ID=

# Optional — which treasury tokens the frontend dashboard shows. Defaults to the WHBAR/SAUCE
# testnet pair demo-rebalance.ts uses if left unset.
NEXT_PUBLIC_TOKEN_IN_ADDRESS=
NEXT_PUBLIC_TOKEN_IN_SYMBOL=
NEXT_PUBLIC_TOKEN_OUT_ADDRESS=
NEXT_PUBLIC_TOKEN_OUT_SYMBOL=

# Optional, deploy.ts only — deploy a Safe that starts with several owners. Comma-separated owner
# addresses and the threshold; leave both blank for a 1-of-1 Safe owned by the operator. A
# multi-owner Safe can't be configured by one key, so deploy.ts prints the module/guard steps for
# the owners to submit instead of executing them.
SAFE_OWNERS=
SAFE_THRESHOLD=

# Only needed for deploy-multisig-rebalance.ts — two throwaway testnet EVM accounts (fund each
# with a little HBAR; Hedera auto-creates the account on first transfer in) that become the
# Safe's 2nd and 3rd owners for the 2-of-3 quorum proof. Never real accounts.
OWNER2_ADDRESS=
OWNER2_KEY=
OWNER3_ADDRESS=
